---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { formatDate } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { data } = post;
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {data.tags.length > 0 && (
          <span class="post-tags">
            {data.tags.map((tag) => (
              <a class="tag-pill" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {prev ? (
          <a class="post-nav-item prev" href={withBase(`/posts/${prev.id}/`)}>
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="post-nav-item next" href={withBase(`/posts/${next.id}/`)}>
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
