---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { formatDate } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
const prev = Astro.props.prev;
const next = Astro.props.next;
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
        {data.tags.length > 0 && (
          <span class="post-tags">
            {data.tags.map((tag) => (
              <a class="post-tag" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="post-nav" aria-label="文章导航">
        {prev ? (
          <a href={withBase(`/posts/${prev.id}/`)}>
            <span class="post-nav-label">← 上一篇</span>
            {prev.data.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={withBase(`/posts/${next.id}/`)} style="text-align:right;">
            <span class="post-nav-label">下一篇 →</span>
            {next.data.title}
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
