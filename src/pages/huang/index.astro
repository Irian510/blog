</style>

<script>
  function bootHuang() {
    const root = document.querySelector<HTMLElement>('.huang-page');
    if (!root || root.dataset.booted === '1') return;
    root.dataset.booted = '1';

    const lb = root.querySelector<HTMLElement>('.h-lb');
    const lbImg = root.querySelector<HTMLImageElement>('.h-lb-body img');
    const lbTitle = root.querySelector<HTMLElement>('.h-lb-text h4');
    const lbMeta = root.querySelector<HTMLElement>('.h-lb-text span');
    const lbLink = root.querySelector<HTMLAnchorElement>('.h-lb-bar a');
    const lbClose = root.querySelector<HTMLButtonElement>('.h-lb-close');

    const openLb = (btn: HTMLElement) => {
      if (!lb || !lbImg || !lbTitle || !lbMeta || !lbLink) return;
      lbImg.src = btn.dataset.full || '';
      lbImg.alt = btn.dataset.title || '';
      lbTitle.textContent = btn.dataset.title || '';
      lbMeta.textContent = btn.dataset.meta || '';
      lbLink.href = btn.dataset.href || '#';
      lb.classList.add('open');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLb = () => {
      if (!lb) return;
      lb.classList.remove('open');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    root.querySelectorAll<HTMLElement>('[data-shot]').forEach((btn) => {
      btn.addEventListener('click', () => openLb(btn));
    });

    lbClose?.addEventListener('click', closeLb);
    lb?.addEventListener('click', (e) => {
      if (e.target === lb || e.target === lbImg) closeLb();
    });

    if (!(window as any).__huangEscBound) {
      (window as any).__huangEscBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelector('.h-lb.open')?.classList.remove('open');
          document.body.style.overflow = '';
        }
      });
    }

    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('.h-nav a'));
    const sections = links
      .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') || ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const syncNav = () => {
      const y = window.scrollY + 140;
      let active = 0;
      sections.forEach((section, i) => {
        if (section.offsetTop <= y) active = i;
      });
      links.forEach((link, i) => link.classList.toggle('on', i === active));
    };

    if ((window as any).__huangSyncNav) {
      window.removeEventListener('scroll', (window as any).__huangSyncNav);
    }
    (window as any).__huangSyncNav = syncNav;
    window.addEventListener('scroll', syncNav, { passive: true });
    syncNav();
  }

  bootHuang();
  document.addEventListener('astro:page-load', bootHuang);
</script>
