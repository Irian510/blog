---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const published = posts.filter((p) => !p.data.draft);
  const tagSet = new Set<string>();
  published.forEach((p) => p.data.tags.forEach((t) => tagSet.add(t)));
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const all = await getCollection('posts');
const posts = all
  .filter((p) => !p.data.draft && p.data.tags.includes(tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${tag}`}>
  <header class="page-head">
    <h1 class="page-title">#{tag}</h1>
    <p class="page-sub">共 {posts.length} 篇文章 · <a href={withBase('/tags/')}>返回全部标签</a></p>
  </header>

  <PostList posts={posts} />
</BaseLayout>
