---
import { withBase } from '../lib/url';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 · Irian</title>
    <meta http-equiv="refresh" content="0; url={withBase('/')}" />
    <style>
      body { font-family: -apple-system, sans-serif; text-align: center; padding: 4rem 1rem; }
      h1 { font-size: 4rem; margin: 0; }
    </style>
  </head>
  <body>
    <h1>404</h1>
    <p>页面不存在，正在跳转首页...</p>
    <p><a href={withBase('/')}>手动返回首页</a></p>
  </body>
</html>
