---
import { withBase } from '../lib/url';

// 背景音乐：keshi - magnolia
// 音频文件放在 public/audio/magnolia.mp3
const sources = [
  { src: withBase('/audio/magnolia.mp3'), type: 'audio/mpeg' },
] as const;
---

<div class="bgm" id="bgm" data-playing="false">
  <audio id="bgm-audio" loop preload="none" playsinline>
    {sources.map((s) => <source src={s.src} type={s.type} />)}
  </audio>

  <button
    class="bgm-btn"
    id="bgm-btn"
    type="button"
    aria-pressed="false"
    aria-label="播放背景音乐：keshi《magnolia》"
    title="keshi《magnolia》"
  >
    <span class="bgm-icon" aria-hidden="true">
      <svg class="bgm-note" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5.4v13.2a1 1 0 0 0 1.53.85l10.2-6.6a1 1 0 0 0 0-1.7L9.53 4.55A1 1 0 0 0 8 5.4z" />
      </svg>
      <span class="bgm-bars"><i></i><i></i><i></i></span>
    </span>
    <span class="bgm-text">magnolia</span>
    <span class="bgm-hint">点击开启</span>
    <span class="bgm-error">加载失败，点此重试</span>
  </button>
</div>

<style>
  .bgm {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .bgm.is-ready {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .bgm-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    backdrop-filter: var(--glass);
    -webkit-backdrop-filter: var(--glass);
    box-shadow: var(--shadow-md);
    color: var(--text-soft);
    font-family: var(--font-serif);
    font-size: 0.86rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .bgm-btn:hover {
    border-color: var(--accent-line);
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }

  .bgm-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--ring);
  }

  .bgm-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    flex: none;
  }

  .bgm-note,
  .bgm-bars {
    grid-area: 1 / 1;
  }

  .bgm-note {
    width: 0.95rem;
    height: 0.95rem;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .bgm-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.8rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .bgm-bars i {
    display: block;
    width: 2px;
    height: 30%;
    border-radius: 1px;
    background: var(--accent);
    animation: bgm-bar 0.9s ease-in-out infinite;
  }

  .bgm-bars i:nth-child(2) {
    animation-delay: 0.18s;
  }

  .bgm-bars i:nth-child(3) {
    animation-delay: 0.36s;
  }

  .bgm[data-playing='true'] .bgm-note {
    opacity: 0;
    transform: scale(0.7);
  }

  .bgm[data-playing='true'] .bgm-bars {
    opacity: 1;
  }

  .bgm-hint {
    display: none;
    color: var(--accent-2);
    font-size: 0.8rem;
  }

  /* 自动播放被浏览器拦截时，提示一次即可 */
  .bgm.is-blocked .bgm-text {
    display: none;
  }

  .bgm.is-blocked .bgm-hint {
    display: inline;
  }

  .bgm.is-blocked .bgm-btn {
    border-color: var(--accent-line);
  }

  .bgm-error {
    display: none;
    color: var(--accent-2);
    font-size: 0.8rem;
  }

  .bgm.is-error .bgm-text,
  .bgm.is-error .bgm-hint {
    display: none;
  }

  .bgm.is-error .bgm-error {
    display: inline;
  }

  @keyframes bgm-bar {
    0%,
    100% {
      height: 30%;
    }
    50% {
      height: 100%;
    }
  }

  @media (max-width: 480px) {
    .bgm-btn {
      padding: 0.45rem 0.7rem 0.45rem 0.55rem;
      font-size: 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bgm,
    .bgm-note,
    .bgm-bars,
    .bgm-btn {
      transition: none;
    }
    .bgm-bars i {
      animation: none;
    }
  }
</style>

<script>
  const root = document.getElementById('bgm');
  const audio = document.getElementById('bgm-audio');
  const btn = document.getElementById('bgm-btn');

  if (root && audio && btn) {
    const PAUSE_KEY = 'bgm-paused';
    const TIME_KEY = 'bgm-time';
    const VOLUME = 0.32;

    let userPaused = false;
    try {
      userPaused = localStorage.getItem(PAUSE_KEY) === '1';
    } catch {}

    audio.volume = VOLUME;

    const setPlaying = (playing: boolean) => {
      root.dataset.playing = playing ? 'true' : 'false';
      btn.setAttribute('aria-pressed', String(playing));
      btn.setAttribute('aria-label', playing ? '暂停背景音乐' : '播放背景音乐：贝多芬《月光奏鸣曲》第一乐章');
    };

    // 站点是多页架构，切页时接着上次的进度放
    try {
      const saved = parseFloat(sessionStorage.getItem(TIME_KEY) || '0');
      if (saved > 1) {
        audio.addEventListener(
          'loadedmetadata',
          () => {
            if (Number.isFinite(audio.duration) && audio.duration > 0) {
              audio.currentTime = Math.min(saved, audio.duration - 1);
            }
          },
          { once: true }
        );
      }
    } catch {}

    // 多次 play() 交错时，只让最后一次的结果生效
    let attempt = 0;

    const play = async () => {
      const id = ++attempt;
      try {
        await audio.play();
        if (id !== attempt) return true;
        setPlaying(true);
        root.classList.remove('is-blocked', 'is-error');
        root.classList.add('is-ready');
        return true;
      } catch (err) {
        if (id !== attempt) return false;
        // 音源加载失败：保留按钮，提示可重试
        if (err instanceof DOMException && err.name === 'NotSupportedError') {
          setPlaying(false);
          root.classList.add('is-ready', 'is-error');
          return false;
        }
        setPlaying(false);
        root.classList.add('is-ready', 'is-blocked');
        return false;
      }
    };

    const pause = () => {
      attempt++;
      audio.pause();
      setPlaying(false);
      root.classList.remove('is-blocked');
    };

    // 浏览器默认禁止有声自动播放，首次交互时补播
    const firstGesture = (e: Event) => {
      const target = e.target;
      if (target instanceof Element && target.closest('#bgm')) return;
      cleanupGesture();
      if (!userPaused && audio.paused) play();
    };

    const cleanupGesture = () => {
      ['pointerdown', 'keydown', 'touchstart'].forEach((t) =>
        document.removeEventListener(t, firstGesture)
      );
    };

    const armGesture = () => {
      ['pointerdown', 'keydown', 'touchstart'].forEach((t) =>
        document.addEventListener(t, firstGesture, { passive: true })
      );
    };

    btn.addEventListener('click', () => {
      cleanupGesture();
      if (audio.paused) {
        userPaused = false;
        try {
          localStorage.setItem(PAUSE_KEY, '0');
        } catch {}
        if (root.classList.contains('is-error')) {
          root.classList.remove('is-error');
          audio.load();
        }
        play();
      } else {
        userPaused = true;
        try {
          localStorage.setItem(PAUSE_KEY, '1');
        } catch {}
        pause();
      }
    });

    audio.addEventListener('pause', () => setPlaying(false));
    audio.addEventListener('play', () => setPlaying(true));

    // 记录进度
    const saveTime = () => {
      try {
        if (audio.currentTime > 0) sessionStorage.setItem(TIME_KEY, String(audio.currentTime));
      } catch {}
    };
    window.addEventListener('pagehide', saveTime);
    window.setInterval(() => {
      if (!audio.paused) saveTime();
    }, 3000);

    // 音源加载失败时保留按钮，点击可重试
    const lastSource = audio.querySelector('source:last-of-type');
    lastSource?.addEventListener('error', () => {
      root.classList.add('is-ready', 'is-error');
    });

    root.classList.add('is-ready');
    if (userPaused) {
      setPlaying(false);
    } else {
      play().then((ok) => {
        if (!ok) armGesture();
      });
    }
  }
</script>
