---
// 互动三：切换“白内障视角”，理解莫奈晚年为什么越画越蓝、越画越散
import { Image } from 'astro:assets';
import lilies from '../../assets/monet/waterlilies-1916.jpg';
---

<div class="vision" data-vision>
  <div class="vt-stage" data-stage>
    <Image
      src={lilies}
      alt="克劳德·莫奈《睡莲》，1916–1919 年"
      widths={[640, 1100]}
      sizes="(max-width: 720px) 92vw, 740px"
      loading="lazy"
    />
    <span class="vt-warm" aria-hidden="true"></span>
    <span class="vt-label" data-label>正常视力</span>
  </div>

  <div class="vt-bar">
    <div class="vt-head">
      <button type="button" class="vt-toggle" data-toggle aria-pressed="false">
        切换到白内障视角
      </button>
      <span class="vt-credit">原画：莫奈《睡莲》1916–1919 · 公有领域</span>
    </div>
    <p class="vt-caption" data-caption aria-live="polite">
      1923 年接受手术后，莫奈的晶状体被摘除，紫外线大量进入眼睛，他看到的蓝色与紫色比常人更浓——这可能是晚年《睡莲》越来越偏蓝紫的原因之一。
    </p>
  </div>
</div>

<script>
  document.querySelectorAll('[data-vision]').forEach((root) => {
    const stage = root.querySelector('[data-stage]');
    const button = root.querySelector('[data-toggle]');
    const label = root.querySelector('[data-label]');
    const caption = root.querySelector('[data-caption]');
    let cataract = false;

    const normalText =
      '1923 年接受手术后，莫奈的晶状体被摘除，紫外线大量进入眼睛，他看到的蓝色与紫色比常人更浓——这可能是晚年《睡莲》越来越偏蓝紫的原因之一。';
    const cataractText =
      '白内障会让画面整体泛黄、发褐，对比度下降，细节变得模糊。莫奈在信里抱怨过：颜色在他眼里越来越“脏”，他常常在调色时加大颜料的分量，画面于是变得松散、浓烈。';

    button.addEventListener('click', () => {
      cataract = !cataract;
      stage.classList.toggle('is-cataract', cataract);
      button.setAttribute('aria-pressed', String(cataract));
      button.textContent = cataract ? '回到正常视力' : '切换到白内障视角';
      label.textContent = cataract ? '白内障（示意）' : '正常视力';
      caption.textContent = cataract ? cataractText : normalText;
    });
  });
</script>

<style>
  .vision {
    margin: 2rem 0 2.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--shadow-sm);
    backdrop-filter: var(--glass);
    -webkit-backdrop-filter: var(--glass);
    overflow: hidden;
  }

  .vt-stage {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #0f1a1c;
  }

  .vt-stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.7s ease;
  }

  .vt-stage.is-cataract :global(img) {
    filter: blur(1.7px) saturate(1.45) sepia(0.5) hue-rotate(-12deg) contrast(0.88)
      brightness(1.07);
  }

  .vt-warm {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at 50% 45%,
      rgba(255, 236, 196, 0.35),
      rgba(190, 150, 80, 0.42) 70%,
      rgba(120, 90, 40, 0.4)
    );
    opacity: 0;
    transition: opacity 0.7s ease;
    mix-blend-mode: multiply;
  }

  .vt-stage.is-cataract .vt-warm {
    opacity: 1;
  }

  .vt-label {
    position: absolute;
    left: 0.9rem;
    top: 0.8rem;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: rgba(40, 50, 46, 0.72);
    font-size: 0.72rem;
    backdrop-filter: blur(6px);
  }

  .vt-bar {
    display: grid;
    gap: 0.7rem;
    padding: 1rem 1.2rem 1.15rem;
  }

  .vt-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .vt-toggle {
    padding: 0.45rem 1rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .vt-toggle:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .vt-toggle:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .vt-credit {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .vt-caption {
    margin: 0;
    min-height: 4.4em;
    color: var(--text-soft);
    font-size: 0.86rem;
    line-height: 1.75;
  }

  @media (max-width: 560px) {
    .vt-caption {
      min-height: 6.6em;
    }
  }
</style>
