---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';
import { formatDate } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="post-empty">暂无文章，敬请期待</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <article class="post-card">
          <div class="post-card-head">
            <h3 class="post-card-title">
              <a class="post-card-link" href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a>
            </h3>
            <time class="post-card-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>

          {post.data.description && <p class="post-card-desc">{post.data.description}</p>}

          {post.data.tags.length > 0 && (
            <div class="post-card-foot">
              {post.data.tags.map((tag) => (
                <a class="tag-pill" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>
              ))}
            </div>
          )}
        </article>
      </li>
    ))}
  </ul>
)}
